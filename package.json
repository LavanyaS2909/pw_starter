{
  "name": "pw-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test --grep \"C01\" --headed",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "setup": "playwright test tests/auth.setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "dotenv": "^16.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.4.0"
  }
}
